{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "all",
  "semi": false,
  "tabWidth": 2,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "modules/gob-web/styles/normalize.scss",
    "modules/gob-web/stats*.json",
    "build*/",
    "**/package-lock.json"
  ]
}
