{
  "name": "gobbldygook",
  "version": "3.0.0-rc.2",
  "private": true,
  "workspaces": [
    "modules/*"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "testLocationInResults": true,
    "reporters": [
      "default",
      [
        "@flakiness/jest",
        {
          "flakinessProject": "gobbldygook/gobbldygook",
          "title": "Jest",
          "outputFolder": "flakiness-report/jest"
        }
      ]
    ],
    "collectCoverageFrom": [
      "modules/**/*.{ts,tsx}"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/modules/gob-hanson-format/parse-hanson-string.js"
    ],
    "coverageReporters": [
      "json",
      "lcov",
      "text-summary"
    ],
    "globals": {
      "TESTING": true,
      "VERSION": "3.0.0-test"
    },
    "resetModules": true,
    "moduleNameMapper": {
      "^.+\\.s?css$": "<rootDir>/config/jest/style-stub.js"
    },
    "setupFiles": [],
    "setupFilesAfterEnv": [
      "<rootDir>/config/test-harness.js",
      "@testing-library/jest-dom"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/e2e/",
      "\\.support\\.[jt]sx?$",
      "__support__"
    ]
  },
  "greenkeeper": {
    "ignore": [
      "history"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@babel/register": "7.29.7",
    "@changesets/cli": "3.0.3",
    "@flakiness/jest": "1.4.0",
    "@flakiness/playwright": "2.0.2",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "6.9.1",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "3.12.10",
    "@types/lodash": "4.17.25",
    "@types/node": "24.19.1",
    "@types/pegjs": "0.10.6",
    "@types/reach__router": "1.3.15",
    "@types/react-dom": "18.3.7",
    "@types/react-modal": "3.16.3",
    "@types/react-redux": "7.1.34",
    "@types/react-select": "2.0.19",
    "@types/react-window": "1.8.8",
    "@types/redux-logger": "3.0.13",
    "@types/styled-components": "5.1.36",
    "@types/uuid": "3.4.13",
    "babel-jest": "29.7.0",
    "core-js": "3.50.0",
    "cross-env": "10.1.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@reach/router": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1"
    },
    "create-react-context": {
      "react": "^18.3.1"
    },
    "react-input-autosize": {
      "react": "^18.3.1"
    },
    "react-select": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1"
    }
  }
}
