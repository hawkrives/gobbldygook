{
  "name": "gobbldygook",
  "version": "3.0.0-rc.2",
  "private": true,
  "workspaces": [
    "modules/*"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "modules/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/modules/gob-hanson-format/parse-hanson-string.js"
    ],
    "coverageReporters": [
      "json",
      "lcov",
      "text-summary"
    ],
    "globals": {
      "TESTING": true,
      "VERSION": "3.0.0-test"
    },
    "resetModules": true,
    "moduleNameMapper": {
      "^.+\\.s?css$": "<rootDir>/config/flow/css.js.flow"
    },
    "setupFiles": [],
    "setupFilesAfterEnv": [
      "<rootDir>/config/test-harness.js",
      "@testing-library/jest-dom"
    ],
    "testPathIgnorePatterns": [
      "\\.support.js$",
      "__support__"
    ]
  },
  "flow-coverage-report": {
    "globIncludePatterns": [
      "modules/**/*.js"
    ],
    "globExcludePatterns": [
      "**/__tests__/**",
      "**/__mocks__/**",
      "**/*-cli/**",
      "modules/gob-hanson-format/parse-hanson-string.js",
      "modules/gob-web/icons/ionicons-all.js",
      "modules/gob-web/icons/ionicons.js",
      "**/node_modules/**"
    ],
    "reportTypes": [
      "html"
    ]
  },
  "greenkeeper": {
    "ignore": [
      "history"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@babel/core": "7.26.0",
    "@babel/eslint-parser": "7.28.0",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-transform-react-display-name": "7.28.0",
    "@babel/plugin-transform-react-inline-elements": "7.27.1",
    "@babel/plugin-transform-runtime": "7.28.0",
    "@babel/preset-env": "7.28.0",
    "@babel/preset-flow": "7.27.1",
    "@babel/preset-react": "7.27.1",
    "@testing-library/jest-dom": "6.4.8",
    "babel-jest": "29.7.0",
    "core-js": "3.44.0",
    "cross-env": "7.0.3",
    "eslint": "7.32.0",
    "eslint-config-prettier": "6.10.0",
    "eslint-plugin-babel": "5.3.0",
    "eslint-plugin-flowtype": "3.13.0",
    "eslint-plugin-import": "2.22.1",
    "eslint-plugin-react": "7.21.5",
    "flow-bin": "0.82.0",
    "flow-remove-types": "2.122.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "1.15.3",
    "pretty-quick": "2.0.1",
    "regenerator-runtime": "0.13.11",
    "set-blocking": "2.0.0"
  }
}
