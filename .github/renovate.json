{
	"extends": ["config:best-practices", ":semanticCommitsDisabled"],
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["after 5pm every weekday"]
	},
	"ignoreDeps": ["history"],
	"timezone": "America/Chicago",
	"labels": ["renovate"],
	"packageRules": [
		{
			"groupName": "react-dnd packages",
			"matchPackageNames": ["/^react-dnd/"]
		},
		{
			"matchPackageNames": ["redux", "react-redux"],
			"groupName": "redux packages"
		}
	]
}
